#: fuxico/menu.lua:69
msgid ""
"Fuxico %1\n"
"\n"
"\"Who is this?\" only searches the book on this device. No text from the book leaves your e-reader.\n"
"\n"
"%2"
msgstr ""
"Fuxico %1\n"
"\n"
"O \"Quem é esse?\" só busca no livro, dentro do aparelho. Nenhum texto do livro sai do seu leitor.\n"
"\n"
"%2"

