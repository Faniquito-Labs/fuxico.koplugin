msgid "Who is this?"
msgstr "Quem é esse?"

#: fuxico/menu.lua:33
msgid "“Who is this?” settings"
msgstr "Ajustes do “Quem é esse?”"

#: fuxico/menu.lua:35
msgid "Only on proper names"
